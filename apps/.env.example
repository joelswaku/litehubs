# Copy this file to .env and provide production values through Railway variables.
# Never commit real credentials, tokens, API keys, or SMTP passwords.

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/litehubs
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/litehubs

# Server and auth
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=<generate-a-unique-32-character-minimum-secret>
REFRESH_TOKEN_SECRET=<generate-a-different-unique-32-character-minimum-secret>
FRONTEND_URL=http://localhost:3000

# Outbound mail (use a verified sender)
MAIL_FROM_NAME=LiteHubs
MAIL_FROM_EMAIL=<verified-sender@example.com>
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>

# Transactional SMS via Brevo. Use a Brevo REST API key with SMS permission.
# Congo Omega's default country calling code is 243. Keep these server-only.
BREVO_SMS_API_KEY=<brevo-transactional-sms-api-key>
BREVO_SMS_SENDER=CongoOmega
SMS_DEFAULT_COUNTRY_CODE=243

# Private document and media storage
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_FOLDER=litehubs
UPLOAD_MAX_FILE_SIZE_MB=10

# Server-side AI only. Never use a NEXT_PUBLIC variable for this key.
OPENAI_API_KEY=<server-side-api-key>
OPEN_MODEL=gpt-5.6
AI_ENABLED=false
AI_DAILY_REQUEST_LIMIT=20