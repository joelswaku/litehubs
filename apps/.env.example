# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------- database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/congo_omega

# ------------------------------------------------------------------ server ----
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------- auth -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters in production, and must differ from each other.
# Temporary account lock after 5 incorrect passwords: defaults to 15 seconds in development and 15 minutes in production.
# Set this only when you need a different value (in seconds), for example: AUTH_LOCK_DURATION_SECONDS=15
JWT_SECRET=<generate-a-unique-32-character-minimum-secret>
REFRESH_TOKEN_SECRET=<generate-a-different-unique-32-character-minimum-secret>

# ------------------------------------------------------------------- web ------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------ email -----
# Brevo SMTP relay. Find these under Brevo > SMTP & API > SMTP.
# SMTP_USER is the dedicated SMTP login Brevo issues (looks like
# 9a1b2c001@smtp-brevo.com) — not your account email.
# SMTP_PASSWORD is the SMTP key (starts with xsmtpsib-).
# MAIL_FROM_EMAIL must be a sender you have verified in Brevo.
# All four are required when NODE_ENV=production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-smtp-user>
SMTP_PASSWORD=<your-smtp-password>
MAIL_FROM_NAME=LiteHubs
# Verified sender in Brevo. Swap to a congo-omega domain address once verified.
MAIL_FROM_EMAIL=<verified-sender@example.com>
# ----------------------------------------------------------- image uploads ---
# Create these in Cloudinary. Never commit the real API secret.
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
CLOUDINARY_FOLDER=litehubs
UPLOAD_MAX_FILE_SIZE_MB=10
# --------------------------------------------------------------- OpenAI / AI ---
# Keep this key only in the server .env. Never add it to NEXT_PUBLIC variables.
OPENAI_API_KEY=<your-server-side-openai-api-key>
OPEN_MODEL=gpt-5.6
AI_ENABLED=false
AI_DAILY_REQUEST_LIMIT=20