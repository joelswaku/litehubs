            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('code is NOT_FOUND', () => pm.expect(body.error.code).to.eql('NOT_FOUND'));",
                  "pm.test('no stack trace on a 4xx', () => pm.expect(body.error.stack).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON body",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{not valid json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiUrl}}/auth/login",
            "description": "Body-parser failures must surface as 400, not 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('code is ENTITY_PARSE_FAILED', () => pm.expect(body.error.code).to.eql('ENTITY_PARSE_FAILED'));",
                  "pm.test('readable message', () => pm.expect(body.error.message).to.eql('Request body is not valid JSON'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Oversized body",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"blob\":\"{{oversizedBlob}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiUrl}}/auth/login",
            "description": "The JSON body limit is 2mb. The pre-request script builds a 2.5mb payload."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('oversizedBlob', 'x'.repeat(2500000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('413 Payload Too Large', () => pm.response.to.have.status(413));",
                  "const body = pm.response.json();",
                  "pm.test('code is ENTITY_TOO_LARGE', () => pm.expect(body.error.code).to.eql('ENTITY_TOO_LARGE'));",
                  "// Do not keep 2.5mb in the collection.",
                  "pm.collectionVariables.set('oversizedBlob', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Disallowed CORS origin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://evil.example.com"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": "Only FRONTEND_URL is allowed. Any other Origin is refused."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('code is CORS_FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('CORS_FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Allowed CORS origin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('echoes the allowed origin', () => {",
                  "  pm.expect(pm.response.headers.get('access-control-allow-origin')).to.eql('http://localhost:3000');",
                  "});",
                  "pm.test('allows credentials', () => {",
                  "  pm.expect(pm.response.headers.get('access-control-allow-credentials')).to.eql('true');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
