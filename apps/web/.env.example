# Public GA4 measurement ID. This is an identifier, not a secret.
# Set this as a Railway build variable so Next embeds it into the public site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1SRBXY14XJ

# Canonical public website URL used for SEO metadata, sitemap and sharing cards.
NEXT_PUBLIC_SITE_URL=https://litehubs.com

# Token from Search Console's "HTML tag" verification method — the value of the
# content attribute only, not the whole <meta> tag. Leave unset when the domain
# is verified through DNS instead. Must be a build variable: Next inlines
# NEXT_PUBLIC_* at build time, so setting it only at runtime has no effect.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
